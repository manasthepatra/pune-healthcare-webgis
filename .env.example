# Copy to .env and set real values. Variable names only - never commit .env.
POSTGRES_DB=webgis
POSTGRES_USER=webgis
POSTGRES_PASSWORD=change_me
# Host ports (GeoServer uses 8081 so it can coexist with a native GeoServer on 8080)
POSTGRES_PORT=5433
GEOSERVER_PORT=8081
TILESERV_PORT=7800
FEATURESERV_PORT=9000
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=change_me_too

# Used by analysis/*.py and geoserver/publish.py (run on the host, so host=localhost)
DATABASE_URL=postgresql+psycopg2://webgis:change_me@localhost:5433/webgis
GEOSERVER_URL=http://localhost:8081/geoserver
